@model IEnumerable<Mascota>
@{ ViewData["Title"] = "Mascotas"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Mascotas</h2>
    <a asp-action="Crear" class="btn btn-primary">Registrar mascota</a>
</div>
@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}
@if (!Model.Any())
{
    <div class="alert alert-info">No hay mascotas registradas.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Nombre</th><th>Especie</th><th>Raza</th><th>Cliente</th><th>Acciones</th></tr></thead>
            <tbody>
            @foreach (var mascota in Model)
            {
                <tr>
                    <td>@mascota.Nombre</td><td>@mascota.Especie</td><td>@mascota.Raza</td><td>@mascota.Cliente?.Nombre</td>
                    <td>
                        <a asp-action="Citas" asp-route-id="@mascota.Id" class="btn btn-sm btn-outline-primary">Ver citas</a>
                        <a asp-action="Editar" asp-route-id="@mascota.Id" class="btn btn-sm btn-outline-secondary">Modificar</a>
                        <a asp-action="Eliminar" asp-route-id="@mascota.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
