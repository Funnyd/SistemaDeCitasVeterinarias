@model Mascota
@{ ViewData["Title"] = "Eliminar mascota"; }
<h2>Eliminar mascota</h2>
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
<dl class="row">
    <dt class="col-sm-3">Nombre</dt><dd class="col-sm-9">@Model.Nombre</dd>
    <dt class="col-sm-3">Especie</dt><dd class="col-sm-9">@Model.Especie</dd>
    <dt class="col-sm-3">Cliente</dt><dd class="col-sm-9">@Model.Cliente?.Nombre</dd>
</dl>
@if (ViewBag.TieneCitas == true)
{
    <div class="alert alert-warning">Esta mascota tiene citas asociadas y no puede eliminarse para conservar su historial.</div>
    <a asp-action="Citas" asp-route-id="@Model.Id" class="btn btn-outline-primary">Ver citas</a>
}
else
{
    <p>¿Desea eliminar esta mascota? Esta acción es permanente.</p>
    <form asp-action="Eliminar" asp-route-id="@Model.Id" method="post" class="mb-3">
        <button type="submit" class="btn btn-danger">Confirmar eliminación</button>
    </form>
}
<a asp-action="Index" class="btn btn-outline-secondary">Volver a mascotas</a>
