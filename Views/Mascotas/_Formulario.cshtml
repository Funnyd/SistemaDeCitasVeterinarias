@model Mascota
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="mb-3">
    <label asp-for="Nombre" class="form-label">Nombre</label>
    <input asp-for="Nombre" class="form-control" maxlength="20" />
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Especie" class="form-label">Especie</label>
    <input asp-for="Especie" class="form-control" maxlength="20" list="especies" />
    <datalist id="especies"><option value="Perro"></option><option value="Gato"></option><option value="Ave"></option><option value="Conejo"></option></datalist>
    <span asp-validation-for="Especie" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Raza" class="form-label">Raza (opcional)</label>
    <input asp-for="Raza" class="form-control" maxlength="20" />
    <span asp-validation-for="Raza" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="ClienteId" class="form-label">Cliente responsable</label>
    <select asp-for="ClienteId" asp-items="ViewBag.Clientes" class="form-select">
        <option value="">-- Seleccione un cliente --</option>
    </select>
    <span asp-validation-for="ClienteId" class="text-danger"></span>
    <div class="form-text">¿El dueño aún no está registrado? <a asp-controller="Duenos" asp-action="Crear" asp-route-paraMascota="true">Registrar dueño</a>. Al terminar volverás a un formulario nuevo de mascota.</div>
</div>
<button type="submit" class="btn btn-primary">Guardar mascota</button>
<a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
